# Local PostgreSQL (Docker Compose)
POSTGRES_DB=career_intelligence
POSTGRES_USER=cia
POSTGRES_PASSWORD=cia_dev_password
POSTGRES_PORT=5432

# Application database connection (server-side only)
DATABASE_URL=postgresql://cia:cia_dev_password@localhost:5432/career_intelligence

# Groq API key for career analysis generation (https://console.groq.com/keys).
# Leave empty until you have one; generation calls will fail clearly without it.
GROQ_API_KEY=

# Optional: overrides the default Groq model (llama-3.3-70b-versatile).
GROQ_MODEL=
